---
import Box from '../components/Box.jsx';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>experimentalReactChildren text and whitespace</title>
	</head>
	<body>
		<h2>Server only</h2>
		<Box id="static"><p><strong>Hello</strong> <em>world</em></p></Box>
		<Box id="pre"><pre><b>Hello</b>
<b>world</b></pre></Box>

		<h2>Hydrated with client:load</h2>
		<Box id="space" client:load><p><strong>Hello</strong> <em>world</em></p></Box>
		<Box id="text" client:load>Hello <b>world</b></Box>
	</body>
</html>
